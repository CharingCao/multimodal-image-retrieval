# Copy this file to .env and fill in your own credentials.
DASHSCOPE_API_KEY=
QDRANT_HOST=localhost
QDRANT_PORT=6333
COLLECTION_NAME=packaging_materials

# Optional model and endpoint overrides:
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_VL_MODEL=qwen-vl-plus
# EMBEDDING_MODEL=text-embedding-v4

# Optional integrations used by experimental scripts:
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Required only by the experimental depth retrieval scripts:
# DEPTH_DOWNLOAD_URL=https://your-depth-service.example/api/v1/storage/download
# DEPTH_BUCKET=depthimages
